.python-version

# celery beat schedule file
celerybeat-schedule

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/

# --- cNMF benchmark harness (see docs/planning/PROGRESS.md) ---
# Downloaded upstream pytest fixtures (~99MB). Provenance is tracked instead by
# docs/benchmarks/registry/pytest_data_manifest.tsv; re-fetch with download_pytest_data.py
tests/test_data/

# Generated benchmark artifacts and scratch runs. Small manifests under
# docs/benchmarks/registry/ ARE tracked; the bulk artifacts they point to are not.
results/exploratory/
results/scratch/

# Registry holds gate evidence and must survive the blanket *.log rule above.
!docs/benchmarks/registry/*.log

# Generated benchmark datasets and cNMF run directories. Manifests are small and stay
# in version control; counts and factor banks do not (AGENTS.md: keep large datasets and
# generated artifacts out of the repository).
cnmfbench/**/__pycache__/
data/simulated/
